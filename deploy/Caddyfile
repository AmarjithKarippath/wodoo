# TLS is terminated by an upstream reverse proxy.
# This container only serves HTTP on port 80 (host → 3013).
{
	auto_https off
}

:80 {
	encode gzip zstd

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	@apex host wodoo.store
	redir @apex https://www.wodoo.store{uri} permanent

	reverse_proxy landing:3000
}
