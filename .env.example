# Port exposed on the host (container always listens on 3000)
LANDING_PORT=3000

# PostgreSQL
POSTGRES_USER=wodoo
POSTGRES_PASSWORD=wodoo
POSTGRES_DB=wodoo
POSTGRES_PORT=5432

# Used by the landing app at runtime (docker-compose sets this automatically)
# DATABASE_URL=postgres://wodoo:wodoo@postgres:5432/wodoo

# Public site URL (for local SEO defaults; production uses .env.production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Baked into the Next.js build for dashboard/login links
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:5173/login
