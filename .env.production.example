# Copy to .env.production and fill in real values before deploying:
#   cp .env.production.example .env.production

# Host ports (Caddy)
# HTTP is published on 3013 — point your reverse proxy / firewall here
PROD_PORT=3013
PROD_HTTPS_PORT=443

# Required — used for Let's Encrypt certificates
ACME_EMAIL=ops@wodoo.store

# Required — use a strong password in production
POSTGRES_USER=wodoo
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=wodoo

# Public site URL (baked into the Next.js build)
NEXT_PUBLIC_SITE_URL=https://www.wodoo.store

# Dashboard / login link shown on the landing page (update when store is live)
NEXT_PUBLIC_DASHBOARD_URL=https://www.wodoo.store
